<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/electric_blue</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#F7F5EE</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/navy_deep</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
